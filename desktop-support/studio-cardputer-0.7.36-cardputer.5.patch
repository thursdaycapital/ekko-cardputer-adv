+    const fetchMock = vi.fn(async () => new Response(JSON.stringify({ ok: true, deviceCode: 'code/one', machines: [] })))
+    vi.stubGlobal('fetch', fetchMock)
+    const { service } = await load()
+    expect(await service.verifyOfficialMcuDeviceCode('code/one')).toBe('official')
+    expect(fetchMock).toHaveBeenCalledWith('https://registry.example.test/global-agent/device/code%2Fone', {
+      method: 'GET', signal: expect.any(AbortSignal),
+    })
+  })
+
+  it.each([
+    [404, '{}', 'unofficial'],
+    [403, '{}', 'unavailable'],
+    [429, '{}', 'unavailable'],
+    [500, '{}', 'unavailable'],
+    [200, '{"ok":true,"deviceCode":"another-code"}', 'unavailable'],
+    [200, '{"ok":false,"deviceCode":"code"}', 'unavailable'],
+    [200, '<html>proxy login</html>', 'unavailable'],
+    [200, 'null', 'unavailable'],
