+export function updateMcuDeviceOfficialStatus(id: number, deviceCode: string, isOfficial: boolean): McuDeviceRecord | null {
+  const db = getDb()
+  if (!db) {
+    const row = jsonGetAll(MCU_DEVICES_TABLE)[String(id)]
+    if (!row || String(row.device_code || '') !== deviceCode) return null
+    const next = { ...row, is_official: isOfficial ? 1 : 0 }
+    jsonSet(MCU_DEVICES_TABLE, String(id), next as any)
+    return rowToRecord(next)
+  }
+
+  const result = db.prepare(`
+    UPDATE ${MCU_DEVICES_TABLE} SET is_official = ? WHERE id = ? AND device_code = ?
+  `).run(isOfficial ? 1 : 0, id, deviceCode)
+  if (Number(result.changes) === 0) return null
+  const row = db.prepare(`SELECT * FROM ${MCU_DEVICES_TABLE} WHERE id = ? AND device_code = ?`)
+    .get(id, deviceCode) as unknown as StoredMcuDeviceRow | undefined
+  return row ? rowToRecord(row) : null
+}
