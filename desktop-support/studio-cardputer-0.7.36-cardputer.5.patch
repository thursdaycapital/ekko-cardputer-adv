+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { mcuAgentCatalog, mcuAgentFromPayload, mcuAgentId, mcuChatRunFields, mcuSessionId,
+  normalizeMcuAgentRuntime, resolveMcuChatRunFields } from '../../packages/server/src/modules/studio/services/global-agent/mcu-agent-runtime'
+
+const studioMocks = vi.hoisted(() => ({ readConfig: vi.fn(), resolveProvider: vi.fn() }))
+vi.mock('../../packages/server/src/modules/studio/public/profile-config', () => ({
+  readConfigYamlForProfile: studioMocks.readConfig,
+}))
+vi.mock('../../packages/server/src/modules/studio/public/chat-agent-runtime', () => ({
+  resolveChatEkkoProviderRuntimeConfig: studioMocks.resolveProvider,
+}))
+
+describe('native MCU canonical agent routing', () => {
+  beforeEach(() => {
+    studioMocks.readConfig.mockReset().mockResolvedValue({ model: { provider: 'custom:studio', default: 'studio-model' } })
+    studioMocks.resolveProvider.mockReset().mockResolvedValue({ apiMode: 'chat_completions', apiKey: 'private-key' })
+  })
+  it('exposes the canonical sixteen without inventing installation status', () => {
+    const catalog = mcuAgentCatalog()
+    expect(catalog.agents.map(agent => agent.id)).toEqual([
+      'ekko-agent', 'hermes', 'claude-code', 'codex', 'pi', 'grok', 'opencode', 'dsh',
+      'cursor', 'antigravity', 'qwen', 'kimi', 'codebuddy', 'qoder', 'copilot', 'zcode',
+    ])
+    expect(catalog.selection_ack_required).toBe(true)
+    expect(catalog.agents.every(agent => !('installed' in agent))).toBe(true)
+  })
+
+  it('routes every canonical selection to that agent rather than silently choosing Ekko', () => {
+    for (const { id } of mcuAgentCatalog().agents) {
+      const runtime = mcuAgentFromPayload({ agentId: id })
+      expect(mcuAgentId(runtime)).toBe(id)
+      const fields = mcuChatRunFields(runtime)
+      if (id === 'hermes') {
+        expect(fields.source).toBe('global_agent')
+        expect(fields).not.toHaveProperty('coding_agent_id')
+      } else {
+        expect(fields).toMatchObject({ source: 'coding_agent', coding_agent_id: id })
+        if (id !== 'ekko-agent') expect(fields).toHaveProperty('mode', ['cursor', 'qoder'].includes(id) ? 'global' : 'scoped')
+      }
+    }
+  })
+
+  it('resolves every supported coding agent from the current Profile without forwarding secrets', async () => {
+    for (const { id, modes } of mcuAgentCatalog().agents) {
+      if (id === 'ekko-agent' || id === 'hermes' || !modes.includes('scoped')) continue
+      const fields = await resolveMcuChatRunFields(normalizeMcuAgentRuntime(id), 'research', 'text')
+      expect(fields).toMatchObject({ coding_agent_id: id, mode: 'scoped', provider: 'custom:studio',
+        model: 'studio-model', apiMode: 'chat_completions' })
+      expect(fields).not.toHaveProperty('apiKey')
+      expect(fields).not.toHaveProperty('instructions')
+    }
+    expect(studioMocks.readConfig).toHaveBeenCalledWith('research')
+    expect(studioMocks.resolveProvider).toHaveBeenCalledWith({ profile: 'research', provider: 'custom:studio', model: 'studio-model' })
+  })
+
+  it('reloads the Profile for each turn and preserves its current API protocol', async () => {
+    await expect(resolveMcuChatRunFields('pi', 'research')).resolves.toMatchObject({ model: 'studio-model' })
+    studioMocks.readConfig.mockResolvedValue({ model: { provider: 'custom:second', default: 'changed-model' } })
+    studioMocks.resolveProvider.mockResolvedValue({ apiMode: 'anthropic_messages' })
+    await expect(resolveMcuChatRunFields('pi', 'research')).resolves.toMatchObject({
+      provider: 'custom:second', model: 'changed-model', apiMode: 'anthropic_messages',
+    })
+    studioMocks.resolveProvider.mockResolvedValue({ apiMode: 'codex_app_server' })
+    await expect(resolveMcuChatRunFields('codex', 'research')).resolves.toHaveProperty('apiMode', 'codex_responses')
+  })
+
+  it('preserves native Ekko, Hermes and global-only CLI routes without reading Studio credentials', async () => {
+    for (const id of ['ekko', 'hermes', 'cursor', 'qoder'] as const) {
+      expect(await resolveMcuChatRunFields(id, 'research')).toEqual(mcuChatRunFields(id))
+    }
+    expect(studioMocks.readConfig).not.toHaveBeenCalled()
+    expect(studioMocks.resolveProvider).not.toHaveBeenCalled()
+  })
+
+  it('reports missing models, unsupported protocols and subscription-only providers instead of falling back', async () => {
+    studioMocks.readConfig.mockResolvedValue({})
+    await expect(resolveMcuChatRunFields('claude-code', 'research')).rejects.toThrow('required together')
+    studioMocks.readConfig.mockResolvedValue({ model: { provider: 'claude-oauth', default: 'subscription-model' } })
+    await expect(resolveMcuChatRunFields('claude-code', 'research')).rejects.toThrow('does not support OAuth')
+    studioMocks.readConfig.mockResolvedValue({ model: { provider: 'custom:bedrock', default: 'model' } })
+    studioMocks.resolveProvider.mockResolvedValue({ apiMode: 'bedrock_converse' })
+    await expect(resolveMcuChatRunFields('claude-code', 'research')).rejects.toThrow('Unsupported apiMode')
+  })
+
+  it('keeps legacy default semantics but rejects malformed or unknown explicit ids', () => {
+    expect(normalizeMcuAgentRuntime(undefined)).toBe('ekko')
+    expect(normalizeMcuAgentRuntime('Hermes')).toBe('hermes')
+    expect(mcuAgentFromPayload({ agentId: 'codex', agentRuntime: 'ekko' })).toBe('codex')
+    for (const id of ['missing', 'claude', '', 'CODEX', {}, null]) {
+      expect(() => mcuAgentFromPayload({ agentId: id })).toThrow('unsupported_mcu_agent')
+    }
+    expect(() => normalizeMcuAgentRuntime('missing')).toThrow('unsupported_mcu_agent')
+  })
+
+  it('does not force keyboard conversations into brief plain-text voice instructions', () => {
+    for (const { id } of mcuAgentCatalog().agents) {
+      const runtime = mcuAgentFromPayload({ agentId: id })
+      expect(mcuChatRunFields(runtime)).toHaveProperty('instructions')
+      expect(mcuChatRunFields(runtime, 'text')).not.toHaveProperty('instructions')
+      expect(mcuChatRunFields(runtime, 'text').source).toBe(mcuChatRunFields(runtime).source)
+    }
+  })
+
+  it('preserves both old session algorithms and isolates all new agent/device/profile tuples', () => {
+    expect(mcuSessionId('Device!1', '中文', 'ekko')).toBe('mcu-device-1-default-ekko')
+    expect(mcuSessionId('Device!1', '中文', 'hermes')).toBe('mcu-device-1-default-hermes')
+    const ids = new Set<string>()
+    for (const agent of mcuAgentCatalog().agents.slice(2)) {
+      for (const device of ['device-1', 'Device-1', '设备一', '设备二', 'a'.repeat(100), 'a'.repeat(99) + 'b']) {
+        for (const profile of ['default', '中文一', '中文二', 'A', 'a']) {
+          const id = mcuSessionId(device, profile, normalizeMcuAgentRuntime(agent.id))
+          expect(ids.has(id)).toBe(false)
+          ids.add(id)
+        }
+      }
+    }
+  })
+})
