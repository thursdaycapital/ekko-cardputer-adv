@@ -0,0 +1,62 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+describe('MCU native conversation repository', () => {
+  let db: any
+  beforeEach(async () => {
+    vi.resetModules()
+    const { DatabaseSync } = await import('node:sqlite')
+    db = new DatabaseSync(':memory:')
+    vi.doMock('../../packages/server/src/modules/studio/infrastructure/database/index', () => ({
+      getDb: () => db, isSqliteAvailable: () => true, getStoragePath: () => ':memory:',
+    }))
+    const { initAllHermesTables } = await import('../../packages/server/src/modules/studio/infrastructure/database/schemas')
+    initAllHermesTables()
+  })
+  afterEach(() => {
+    db?.close()
+    vi.doUnmock('../../packages/server/src/modules/studio/infrastructure/database/index')
+    vi.resetModules()
+  })
+  it('paginates visible messages by exact native session without tools/reasoning or cross-session reads', async () => {
+    const store = await import('../../packages/server/src/modules/studio/repositories/session-store')
+    store.createSession({ id: 'native-session', profile: 'default', source: 'coding_agent' })
+    store.createSession({ id: 'other-session', profile: 'other', source: 'coding_agent' })
+    const ids: number[] = []
+    for (let index = 0; index < 16; index++) {
+      ids.push(store.addMessage({ session_id: 'native-session', role: index % 2 ? 'assistant' : 'user', content: `visible-${index}`, timestamp: index + 1 })!)
+      store.addMessage({ session_id: 'native-session', role: 'tool', content: 'not conversational text', timestamp: index + 1 })
+    }
+    const foreign = store.addMessage({ session_id: 'other-session', role: 'assistant', content: 'foreign', timestamp: 99 })!
+    const page = store.getMcuConversationMessages('native-session', 12)
+    expect(page.map(row => row.id)).toEqual(ids.slice(4))
+    expect(page.every(row => row.role === 'user' || row.role === 'assistant')).toBe(true)
+    expect(store.getMcuConversationMessages('native-session', 12, String(page[0]!.id)).map(row => row.id)).toEqual(ids.slice(0, 4))
+    expect(store.getMcuConversationMessage('native-session', String(foreign))).toBeNull()
+    expect(store.getMcuConversationMessage('native-session', String(ids[5]))?.content).toBe('visible-5')
+  })
+
+  it('returns adjacent newer pages by insertion ID even when every timestamp repeats or goes backwards', async () => {
+    const store = await import('../../packages/server/src/modules/studio/repositories/session-store')
+    store.createSession({ id: 'two-way', profile: 'default', source: 'coding_agent' })
+    store.createSession({ id: 'foreign', profile: 'other', source: 'coding_agent' })
+    const ids: number[] = []
+    for (let index = 0; index < 35; index++) {
+      ids.push(store.addMessage({ session_id: 'two-way', role: index % 2 ? 'assistant' : 'user', content: `message-${index}`, timestamp: index === 34 ? 1 : 100 })!)
+      store.addMessage({ session_id: 'two-way', role: 'tool', content: 'excluded', timestamp: 100 })
+      store.addMessage({ session_id: 'foreign', role: 'assistant', content: 'excluded foreign', timestamp: 100 })
+    }
+    const latest = store.getMcuConversationMessages('two-way', 13).slice(-12)
+    expect(latest.map(row => row.id)).toEqual(ids.slice(23))
+    const older = store.getMcuConversationMessages('two-way', 13, String(latest[0]!.id)).slice(-12)
+    expect(older.map(row => row.id)).toEqual(ids.slice(11, 23))
+    const newer = store.getMcuConversationMessages('two-way', 13, undefined, String(older.at(-1)!.id))
+    expect(newer.map(row => row.id)).toEqual(ids.slice(23))
+    const oldest = store.getMcuConversationMessages('two-way', 13, String(older[0]!.id))
+    expect(oldest.map(row => row.id)).toEqual(ids.slice(0, 11))
+    const forwardWithLookahead = store.getMcuConversationMessages('two-way', 13, undefined, String(oldest.at(-1)!.id))
+    expect(forwardWithLookahead.map(row => row.id)).toEqual(ids.slice(11, 24))
+    expect(forwardWithLookahead.slice(0, 12).map(row => row.id)).toEqual(older.map(row => row.id))
+    expect(store.getMcuConversationMessages('two-way', 13, undefined, String(latest.at(-1)!.id))).toEqual([])
+    expect(() => store.getMcuConversationMessages('two-way', 12, '1', '2')).toThrow('ambiguous_history_cursor')
+  })
+})
diff --git a/tests/server/mcu-chat-protocol.test.ts b/tests/server/mcu-chat-protocol.test.ts
new file mode 100644
index 0000000..2ac84a9
--- /dev/null
+++ b/tests/server/mcu-chat-protocol.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it } from 'vitest'
+import { emitMcuChatChunks, emitMcuChatWindow, mcuChatMessageId, mcuChatRequestId,
+  mcuChatWindow, McuChatRequests } from '../../packages/server/src/modules/studio/services/global-agent/mcu-chat'
+
+const context = { agentId: 'antigravity', profile: '中文'.repeat(10), selectionVersion: 123, sessionId: 'mcu-' + 'x'.repeat(150) }
+
+describe('MCU native chat framing', () => {
+  it('preserves raw UTF8 and JSON escaped text within both byte budgets', () => {
+    const text = '中文😀é\\"\n\t\u0000'.repeat(200)
+    const frames: any[] = []
+    const end = emitMcuChatChunks(p => frames.push(p), context, 'r'.repeat(64), 'm'.repeat(128), 'assistant', text, 0, true)
+    expect(end).toBe(Buffer.byteLength(text))
+    expect(frames.map(f => f.text).join('')).toBe(text)
+    let next = 0
+    for (const frame of frames) {
+      expect(frame.offset).toBe(next)
+      expect(Buffer.byteLength(frame.text)).toBeLessThanOrEqual(512)
+      expect(Buffer.byteLength(JSON.stringify(frame))).toBeLessThanOrEqual(1024)
+      expect(frame.text).not.toContain('\ufffd')
+      next += Buffer.byteLength(frame.text)
+    }
+    expect(frames.at(-1).final).toBe(true)
+    expect(frames.slice(0, -1).every(f => !f.final)).toBe(true)
+  })
+
+  it('finishes an empty streamed message explicitly with the full byte count', () => {
+    const frames: any[] = []
+    emitMcuChatChunks(p => frames.push(p), context, 'request', 'message', 'assistant', '', 8192, true, { totalBytes: 8192 })
+    expect(frames).toEqual([expect.objectContaining({ offset: 8192, text: '', final: true, totalBytes: 8192 })])
+  })
+
+  it('returns later UTF8 windows without losing the message total or pretending the tail is complete', () => {
+    const text = '汉😀'.repeat(600) + 'THE END'
+    const first = mcuChatWindow(text)
+    expect(first.truncatedAfter).toBe(true)
+    expect(first.totalBytes).toBe(Buffer.byteLength(text))
+    const second = mcuChatWindow(text, 1025)
+    expect(second.startOffset).toBeLessThanOrEqual(1025)
+    expect(second.startOffset).toBeGreaterThan(1021)
+    expect(second.text).not.toContain('\ufffd')
+    const last = mcuChatWindow(text, Buffer.byteLength(text) - 100)
+    expect(last.text).toContain('THE END')
+    expect(last.truncatedAfter).toBe(false)
+    const frames: any[] = []
+    emitMcuChatWindow(p => frames.push(p), context, 'history', { messageId: 'message', role: 'assistant', text, messageFinal: true }, 1025)
+    expect(frames[0]).toMatchObject({ type: 'mcu.chat.message.begin', startOffset: second.startOffset,
+      totalBytes: Buffer.byteLength(text), truncatedBefore: true, truncatedAfter: true, messageFinal: true })
+    expect(frames.at(-1).final).toBe(true)
+  })
+
+  it.each([-1, NaN, Infinity, 0.5])('rejects invalid byte offset %s', offset => {
+    expect(() => mcuChatWindow('text', offset)).toThrow('invalid_message_offset')
+  })
+  it.each([0, -1, NaN, Infinity, 1025, 1.5])('rejects invalid window size %s', limit => {
+    expect(() => mcuChatWindow('text', 0, limit)).toThrow('invalid_window_limit')
+  })
+  it.each(['', 'x'.repeat(65), '有中文', 'contains space', '\n', null, 4])('rejects unsafe request ID %s', value => {
+    expect(() => mcuChatRequestId(value)).toThrow('invalid_request_id')
+  })
+  it('does not truncate long source identifiers into equal message identities', () => {
+    expect(mcuChatRequestId('valid-123:456')).toBe('valid-123:456')
+    const prefix = '汉'.repeat(1000)
+    const a = mcuChatMessageId('session', prefix + 'a')
+    expect(a).not.toBe(mcuChatMessageId('session', prefix + 'b'))
+    expect(a).not.toBe(mcuChatMessageId('other-session', prefix + 'a'))
+    expect(a).toMatch(/^msg-[a-f0-9]{64}$/)
+  })
+  it('deduplicates process-lifetime accepted requests and rejects capacity rather than evicting IDs', () => {
+    const requests = new McuChatRequests(1)
+    const first = requests.reserve('scope', 'id', 'full text')
+    expect(first.duplicate).toBe(false)
+    expect(requests.reserve('scope', 'id', 'full text')).toEqual({ interactionId: first.interactionId, duplicate: true })
+    expect(requests.lookup('scope', 'id', 'full text')).toEqual({ interactionId: first.interactionId, duplicate: true })
+    expect(() => requests.reserve('scope', 'id', 'different')).toThrow('request_id_conflict')
+    expect(() => requests.reserve('scope', 'next', 'text')).toThrow('request_capacity_reached')
+    expect(() => requests.reserve('other-scope', 'id', 'full text')).toThrow('request_capacity_reached')
+    expect(requests.lookup('unknown', 'id', 'full text')).toBeNull()
+  })
+})
