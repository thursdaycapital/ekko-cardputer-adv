+  await panel.getByRole('button', { name: 'Refresh', exact: true }).click()
+  await expect(channel).toHaveText('Official')
+  expect(reads).toBe(2)
+})
+
+test('verification outage is distinct from unofficial status and gives localized retry guidance', async ({ page }) => {
+  await prepare(page)
+  await page.route('**/api/mcu-devices', route => route.fulfill({ json: {
+    devices: [{ ...device, is_official: true, official_verification: 'unavailable' }],
+  } }))
+  let attempts = 0
+  await page.route('**/api/mcu-devices/1/remote-connect', route => {
+    attempts += 1
+    return route.fulfill({ status: 503, json: { error: 'upstream unavailable', code: 'official_verification_unavailable' } })
+  })
+
+  await page.goto('/#/hermes/connections?tab=mcu')
+  const row = page.locator('.mcu-devices-panel').getByRole('row').filter({ hasText: 'Cardputer' })
+  const connect = row.getByRole('button', { name: 'Remote connect', exact: true })
+  await expect(row.locator('.n-tag').first()).toHaveText('Unverified')
+  await expect(connect).toBeEnabled()
+  await connect.click()
+  await expect(page.locator('.n-message')).toContainText('Official device verification is temporarily unavailable. Try again later.')
+  await expect(connect).toBeEnabled()
+  await expect(row.locator('.n-tag').first()).toHaveText('Unverified')
+  expect(attempts).toBe(1)
+})
+
+test('server rejection still prevents a genuinely unofficial device from connecting', async ({ page }) => {
+  await prepare(page)
+  await page.route('**/api/mcu-devices', route => route.fulfill({ json: { devices: [device] } }))
+  await page.route('**/api/mcu-devices/1/remote-connect', route => route.fulfill({
+    status: 403, json: { error: 'Official device required' },
+  }))
+
+  await page.goto('/#/hermes/connections?tab=mcu')
+  const row = page.locator('.mcu-devices-panel').getByRole('row').filter({ hasText: 'Cardputer' })
+  await row.getByRole('button', { name: 'Remote connect', exact: true }).click()
+  await expect(page.locator('.n-message').filter({ hasText: 'Official device required' })).toBeVisible()
+  await expect(row.locator('.n-tag').first()).toHaveText('Unofficial')
+  await expect(row.getByRole('button', { name: 'Remote connect', exact: true })).toBeEnabled()
+  await expect(row.getByRole('button', { name: 'Disconnect', exact: true })).toHaveCount(0)
+})
+
+test('an explicit server rejection clears a stale official channel immediately', async ({ page }) => {
+  await prepare(page)
+  await page.route('**/api/mcu-devices', route => route.fulfill({ json: {
+    devices: [{ ...device, is_official: true, official_verification: 'official' }],
+  } }))
+  await page.route('**/api/mcu-devices/1/remote-connect', route => route.fulfill({
+    status: 403, json: { error: 'Official device required', code: 'unofficial_device_code' },
+  }))
+
+  await page.goto('/#/hermes/connections?tab=mcu')
+  const row = page.locator('.mcu-devices-panel').getByRole('row').filter({ hasText: 'Cardputer' })
+  await expect(row.locator('.n-tag').first()).toHaveText('Official')
+  await row.getByRole('button', { name: 'Remote connect', exact: true }).click()
+  await expect(page.locator('.n-message').filter({ hasText: 'Official device required' })).toBeVisible()
+  await expect(row.locator('.n-tag').first()).toHaveText('Unofficial')
+  await expect(row.locator('.n-tag').nth(2)).toHaveText('Disconnected')
+  await expect(row.getByRole('button', { name: 'Remote connect', exact: true })).toBeEnabled()
+  await expect(row.getByRole('button', { name: 'Disconnect', exact: true })).toHaveCount(0)
+})
+
+test('saving a device name keeps remote connection disabled until the save finishes', async ({ page }) => {
+  await prepare(page)
+  await page.route('**/api/mcu-devices', route => route.fulfill({ json: { devices: [device] } }))
+  const gate = holdResponse()
+  await page.route('**/api/mcu-devices/1', async route => {
+    expect(route.request().method()).toBe('PATCH')
+    await gate.pending
+    await route.fulfill({ json: { devices: [{ ...device, name: 'Updated Cardputer' }] } })
+  })
+
+  await page.goto('/#/hermes/connections?tab=mcu')
+  const row = page.locator('.mcu-devices-panel').getByRole('row').filter({ hasText: 'Cardputer' })
+  await row.getByRole('button', { name: 'Edit', exact: true }).click()
+  const dialog = page.getByRole('dialog')
+  await dialog.getByRole('textbox').fill('Updated Cardputer')
+  await dialog.getByRole('button', { name: 'Save', exact: true }).click()
+  await expect(row.getByRole('button', { name: 'Remote connect', exact: true })).toBeDisabled()
+
+  gate.release()
+  await expect(dialog).toHaveCount(0)
+  await expect(row.getByRole('button', { name: 'Remote connect', exact: true })).toBeEnabled()
+})
