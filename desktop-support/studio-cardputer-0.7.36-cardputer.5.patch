@@ -0,0 +1,160 @@
+import { expect, test, type Page } from '@playwright/test'
+import { authenticate, mockChatSocket, mockHermesApi } from './fixtures'
+
+const device = {
+  id: 1,
+  name: 'Cardputer',
+  device_code: 'test-cardputer',
+  is_official: false,
+  created_at: 1,
+  lan_connected: true,
+  remote_connected: false,
+}
+const releases = new Set<() => void>()
+
+test.afterEach(() => {
+  for (const release of releases) release()
+  releases.clear()
+})
+
+function holdResponse() {
+  let release!: () => void
+  const pending = new Promise<void>(resolve => { release = resolve })
+  releases.add(release)
+  return { pending, release }
+}
+
+async function prepare(page: Page) {
+  await authenticate(page)
+  await mockHermesApi(page)
+  await mockChatSocket(page)
+}
+
+test('stale unofficial status allows authoritative connect and blocks duplicate requests', async ({ page }) => {
+  await prepare(page)
+  await page.route('**/api/mcu-devices', route => route.fulfill({ json: {
+    devices: [device, { ...device, id: 2, name: 'Other device', device_code: 'other-device' }],
+  } }))
+  const gate = holdResponse()
+  let requests = 0
+  await page.route('**/api/mcu-devices/1/remote-connect', async route => {
+    requests += 1
+    expect(route.request().method()).toBe('POST')
+    await gate.pending
+    await route.fulfill({ json: { devices: [{ ...device, is_official: true, official_verification: 'official', remote_connected: true }] } })
+  })
+
+  await page.goto('/#/hermes/connections?tab=mcu')
+  const panel = page.locator('.mcu-devices-panel')
+  const row = panel.getByRole('row').filter({ hasText: 'Cardputer' })
+  const connect = row.getByRole('button', { name: /Remote connect$/ })
+  await expect(row.locator('.n-tag').first()).toHaveText('Unofficial')
+  await expect(connect).toBeEnabled()
+  await connect.click()
+  await expect(connect).toBeDisabled()
+  await expect(panel.getByRole('row').filter({ hasText: 'Other device' }).getByRole('button', { name: 'Remote connect', exact: true })).toBeDisabled()
+  await connect.evaluate(button => (button as HTMLButtonElement).click())
+  expect(requests).toBe(1)
+
+  gate.release()
+  await expect(row.locator('.n-tag').first()).toHaveText('Official')
+  await expect(row.getByRole('button', { name: 'Disconnect', exact: true })).toBeEnabled()
+})
+
+test('refresh replaces a stale unofficial channel with the verified official result', async ({ page }) => {
+  await prepare(page)
+  let reads = 0
+  await page.route('**/api/mcu-devices', route => route.fulfill({ json: {
+    devices: [{ ...device, is_official: ++reads > 1, official_verification: reads > 1 ? 'official' : 'unofficial' }],
+  } }))
+
+  await page.goto('/#/hermes/connections?tab=mcu')
+  const panel = page.locator('.mcu-devices-panel')
+  const channel = panel.getByRole('row').filter({ hasText: 'Cardputer' }).locator('.n-tag').first()
