new file mode 100644
index 0000000..036a286
--- /dev/null
+++ b/packages/server/src/modules/studio/services/devices/mcu-device-verification.ts
@@ -0,0 +1,51 @@
+import { config } from '../../public/config'
+import { listMcuDevices, updateMcuDeviceOfficialStatus, type McuDeviceRecord } from './mcu-devices'
+
+export type McuDeviceVerification = 'official' | 'unofficial' | 'unavailable'
+export type VerifiedMcuDeviceRecord = McuDeviceRecord & { official_verification?: McuDeviceVerification }
+
+const VERIFICATION_TIMEOUT_MS = 5000
+const VERIFICATION_CONCURRENCY = 4
+
+/** Only the remote registry can grant or revoke a device's official status. */
+export async function verifyOfficialMcuDeviceCode(deviceCode: string): Promise<McuDeviceVerification> {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), VERIFICATION_TIMEOUT_MS)
+  try {
+    const url = `${config.remoteRelay.url.replace(/\/$/, '')}/global-agent/device/${encodeURIComponent(deviceCode)}`
+    const response = await fetch(url, { method: 'GET', signal: controller.signal })
+    if (response.status === 404) return 'unofficial'
+    if (!response.ok) return 'unavailable'
+    const body = await response.json() as { ok?: unknown; deviceCode?: unknown } | null
+    return body?.ok === true && body.deviceCode === deviceCode ? 'official' : 'unavailable'
+  } catch {
+    return 'unavailable'
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+/** Refresh a snapshot with bounded concurrency, preserving cached status on outages. */
+export async function refreshMcuDeviceOfficialStatuses(): Promise<VerifiedMcuDeviceRecord[]> {
+  const devices = listMcuDevices()
+  const results = new Map<number, { deviceCode: string; status: McuDeviceVerification }>()
+  let nextIndex = 0
+  async function worker() {
+    while (nextIndex < devices.length) {
+      const device = devices[nextIndex++]!
+      const status = await verifyOfficialMcuDeviceCode(device.device_code)
+      results.set(device.id, { deviceCode: device.device_code, status })
+      if (status !== 'unavailable') {
+        updateMcuDeviceOfficialStatus(device.id, device.device_code, status === 'official')
+      }
+    }
+  }
+  await Promise.all(Array.from({ length: Math.min(VERIFICATION_CONCURRENCY, devices.length) }, worker))
+  // Read again so concurrent deletion/rename cannot return a stale snapshot.
+  return listMcuDevices().map(device => {
+    const result = results.get(device.id)
+    return result?.deviceCode === device.device_code
+      ? { ...device, official_verification: result.status }
+      : device
+  })
+}
diff --git a/packages/server/src/modules/studio/services/global-agent/mcu-chat.ts b/packages/server/src/modules/studio/services/global-agent/mcu-chat.ts
new file mode 100644
index 0000000..f7a6608
--- /dev/null
+++ b/packages/server/src/modules/studio/services/global-agent/mcu-chat.ts
@@ -0,0 +1,107 @@
+import { createHash, randomUUID } from 'node:crypto'
+
+export const MCU_CHAT_PROTOCOL = 1
+export const MCU_CHAT_TEXT_LIMIT = 4096
+export const MCU_CHAT_WINDOW_BYTES = 1024
+const MAX_FRAME_BYTES = 1024
+const MAX_CHUNK_BYTES = 512
+
+export interface McuChatContext {
+  agentId: string
+  profile: string
+  selectionVersion: number
+  sessionId: string
+}
+export interface McuChatMessage {
+  messageId: string
+  role: 'user' | 'assistant'
+  text: string
+  messageFinal: boolean
+}
+export type McuChatEmit = (payload: Record<string, unknown>) => unknown
+
+export function mcuChatRequestId(value: unknown): string {
+  if (typeof value !== 'string' || !/^[\x21-\x7e]{1,64}$/.test(value)) throw new Error('invalid_request_id')
+  return value
+}
+
+/** IDs are opaque hashes of the complete source identity, never truncated source IDs. */
+export function mcuChatMessageId(sessionId: string, sourceId: string): string {
+  return `msg-${createHash('sha256').update(sessionId).update('\0').update(sourceId).digest('hex')}`
+}
+
+function byteBoundary(bytes: Buffer, offset: number): number {
+  let value = Math.max(0, Math.min(bytes.length, offset))
+  while (value > 0 && value < bytes.length && (bytes[value]! & 0xc0) === 0x80) value -= 1
+  return value
+}
+
+export function mcuChatWindow(text: string, offset = 0, limit = MCU_CHAT_WINDOW_BYTES) {
+  if (!Number.isSafeInteger(offset) || offset < 0) throw new Error('invalid_message_offset')
+  if (!Number.isSafeInteger(limit) || limit < 4 || limit > MCU_CHAT_WINDOW_BYTES) throw new Error('invalid_window_limit')
+  const bytes = Buffer.from(text, 'utf8')
+  const startOffset = byteBoundary(bytes, offset)
+  const endOffset = byteBoundary(bytes, Math.min(bytes.length, startOffset + limit))
+  return { text: bytes.subarray(startOffset, endOffset).toString('utf8'), startOffset,
+    totalBytes: bytes.length, truncatedBefore: startOffset > 0, truncatedAfter: endOffset < bytes.length }
+}
+
+/** Every body frame, including JSON escaping and context, fits the MCU's bounded parser. */
+export function emitMcuChatChunks(emit: McuChatEmit, context: McuChatContext, requestId: string,
+  messageId: string, role: 'user' | 'assistant', text: string, offset: number, final: boolean,
+  extra: Record<string, unknown> = {}): number {
+  let chunk = ''
+  let chunkBytes = 0
+  let position = offset
+  const payload = (value: string, end: boolean) => ({ type: 'mcu.chat.message', ...context,
+    requestId, messageId, role, offset: position, text: value, final: end, ...extra })
+  const flush = (end: boolean) => {
+    const frame = payload(chunk, end)
+    if (Buffer.byteLength(JSON.stringify(frame)) > MAX_FRAME_BYTES) throw new Error('chat_frame_metadata_too_large')
+    emit(frame)
+    position += chunkBytes
+    chunk = ''; chunkBytes = 0
+  }
+  for (const character of text) {
+    const size = Buffer.byteLength(character)
+    if (chunk && (chunkBytes + size > MAX_CHUNK_BYTES || Buffer.byteLength(JSON.stringify(payload(chunk + character, false))) > MAX_FRAME_BYTES)) flush(false)
+    chunk += character
+    chunkBytes += size
+  }
+  if (chunk || final) flush(final)
+  return position
+}
+
+export function emitMcuChatWindow(emit: McuChatEmit, context: McuChatContext, requestId: string,
+  message: McuChatMessage, offset = 0, limit = MCU_CHAT_WINDOW_BYTES): void {
+  const window = mcuChatWindow(message.text, offset, limit)
+  emit({ type: 'mcu.chat.message.begin', ...context, requestId, messageId: message.messageId,
+    role: message.role, startOffset: window.startOffset, totalBytes: window.totalBytes,
+    messageFinal: message.messageFinal, truncatedBefore: window.truncatedBefore, truncatedAfter: window.truncatedAfter })
+  emitMcuChatChunks(emit, context, requestId, message.messageId, message.role, window.text, window.startOffset, true)
+}
+
+/** A process-lifetime ledger fails closed when full; reconnects cannot evict accepted IDs. */
+export class McuChatRequests {
+  private readonly entries = new Map<string, { digest: string; interactionId: string }>()
+  constructor(private readonly capacity = 4096) {}
+  reserve(scope: string, requestId: string, text: string): { interactionId: string; duplicate: boolean } {
+    const key = JSON.stringify([scope, requestId])
+    const digest = createHash('sha256').update(text).digest('hex')
+    const previous = this.entries.get(key)
+    if (previous) {
+      if (previous.digest !== digest) throw new Error('request_id_conflict')
+      return { interactionId: previous.interactionId, duplicate: true }
+    }
+    if (this.entries.size >= this.capacity) throw new Error('request_capacity_reached')
+    const interactionId = `mcu-text-${randomUUID()}`
+    this.entries.set(key, { digest, interactionId })
+    return { interactionId, duplicate: false }
+  }
+  lookup(scope: string, requestId: string, text: string): { interactionId: string; duplicate: true } | null {
+    const previous = this.entries.get(JSON.stringify([scope, requestId]))
+    if (!previous) return null
+    if (previous.digest !== createHash('sha256').update(text).digest('hex')) throw new Error('request_id_conflict')
+    return { interactionId: previous.interactionId, duplicate: true }
+  }
+}
