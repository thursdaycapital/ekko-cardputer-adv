+    const approved = store.createMcuDevice({ name: 'Approved', deviceCode: 'approved', isOfficial: false })
+    const revoked = store.createMcuDevice({ name: 'Revoked', deviceCode: 'revoked', isOfficial: true })
+    const outage = store.createMcuDevice({ name: 'Outage', deviceCode: 'outage', isOfficial: true })
+    vi.stubGlobal('fetch', vi.fn(async (url: string) => {
+      const code = url.split('/').at(-1)
+      return code === 'revoked' ? new Response('{}', { status: 404 })
+        : code === 'outage' ? new Response('{}', { status: 503 })
+          : new Response(JSON.stringify({ ok: true, deviceCode: code }))
+    }))
+
+    const refreshed = await service.refreshMcuDeviceOfficialStatuses()
+    expect(refreshed.find(device => device.id === approved.id)).toMatchObject({ is_official: true, official_verification: 'official' })
+    expect(refreshed.find(device => device.id === revoked.id)).toMatchObject({ is_official: false, official_verification: 'unofficial' })
+    expect(refreshed.find(device => device.id === outage.id)).toMatchObject({ is_official: true, official_verification: 'unavailable' })
