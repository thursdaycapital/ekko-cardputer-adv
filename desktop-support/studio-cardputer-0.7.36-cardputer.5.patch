+    for (let i = 0; i < 11; i++) store.createMcuDevice({ name: `Box ${i}`, deviceCode: `code-${i}`, isOfficial: false })
+    let active = 0
+    let maximum = 0
+    const complete: Array<() => void> = []
+    vi.stubGlobal('fetch', vi.fn((url: string) => new Promise<Response>(resolve => {
+      maximum = Math.max(maximum, ++active)
+      complete.push(() => {
+        active--
+        resolve(new Response(JSON.stringify({ ok: true, deviceCode: url.split('/').at(-1) })))
+      })
+    })))
+    let settled = false
+    const pending = service.refreshMcuDeviceOfficialStatuses().then(result => { settled = true; return result })
+    while (!settled) {
+      complete.shift()?.()
+      await new Promise(resolve => setImmediate(resolve))
+    }
