+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { flushPromises, mount, type VueWrapper } from '@vue/test-utils'
+import { createI18n } from 'vue-i18n'
+import { defineComponent, h } from 'vue'
+import { NConfigProvider } from 'naive-ui'
+import type { McuDevice } from '@/api/studio/mcu-devices'
+import en from '@/i18n/locales/en'
+import { supportedLocales } from '@/i18n/messages'
+
+const api = vi.hoisted(() => ({
+  fetchMcuDevices: vi.fn(),
+  connectMcuDeviceRemote: vi.fn(),
+  disconnectMcuDeviceRemote: vi.fn(),
+  createMcuDevice: vi.fn(),
+  deleteMcuDevice: vi.fn(),
+  updateMcuDeviceName: vi.fn(),
+}))
+const messages = vi.hoisted(() => ({ success: vi.fn(), error: vi.fn(), warning: vi.fn() }))
+
+vi.mock('@/api/studio/mcu-devices', () => api)
+vi.mock('naive-ui', async importOriginal => ({
+  ...await importOriginal<typeof import('naive-ui')>(),
+  useMessage: () => messages,
+  useDialog: () => ({ warning: vi.fn() }),
+}))
+
+import McuDevicesPanel from '@/components/hermes/connections/McuDevicesPanel.vue'
+
+const device: McuDevice = {
+  id: 1,
+  name: 'Cardputer',
+  device_code: 'test-cardputer',
+  is_official: false,
+  created_at: 1,
+  lan_connected: true,
+  remote_connected: false,
+}
+const wrappers: VueWrapper[] = []
+
+async function render() {
+  const wrapper = mount(defineComponent({
+    setup: () => () => h(NConfigProvider, {}, { default: () => h(McuDevicesPanel) }),
+  }), {
+    attachTo: document.body,
+    global: { plugins: [createI18n({ legacy: false, locale: 'en', messages: { en } })] },
+  })
+  wrappers.push(wrapper)
+  await flushPromises()
+  return wrapper
+}
+
+function button(wrapper: VueWrapper, label: string) {
+  return wrapper.findAll('button').find(item => item.text() === label)!
+}
+
+describe('MCU official status synchronization', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    vi.stubGlobal('ResizeObserver', class { observe() {} unobserve() {} disconnect() {} })
+    api.fetchMcuDevices.mockResolvedValue({ devices: [{ ...device }] })
+  })
+
+  afterEach(() => {
+    for (const wrapper of wrappers.splice(0)) wrapper.unmount()
+    vi.unstubAllGlobals()
+  })
+
+  it('allows a stale unofficial row to request authoritative remote verification', async () => {
+    api.connectMcuDeviceRemote.mockResolvedValue({
+      devices: [{ ...device, is_official: true, official_verification: 'official', remote_connected: true }],
+    })
+    const wrapper = await render()
+    expect(wrapper.find('.n-tag').text()).toBe('Unofficial')
+    expect(button(wrapper, 'Remote connect').attributes('disabled')).toBeUndefined()
+
+    await button(wrapper, 'Remote connect').trigger('click')
+    await flushPromises()
+
+    expect(api.connectMcuDeviceRemote).toHaveBeenCalledWith(1)
+    expect(wrapper.find('.n-tag').text()).toBe('Official')
+    expect(button(wrapper, 'Disconnect')).toBeDefined()
+  })
+
+  it('blocks repeated remote requests while a connection is pending', async () => {
+    let finish!: (value: { devices: McuDevice[] }) => void
+    api.connectMcuDeviceRemote.mockReturnValue(new Promise(resolve => { finish = resolve }))
+    const wrapper = await render()
+
+    await button(wrapper, 'Remote connect').trigger('click')
+    expect(button(wrapper, 'Remote connect').attributes('disabled')).toBeDefined()
+    ;(button(wrapper, 'Remote connect').element as HTMLButtonElement).click()
+    expect(api.connectMcuDeviceRemote).toHaveBeenCalledTimes(1)
+
+    finish({ devices: [{ ...device, is_official: true, remote_connected: true }] })
+    await flushPromises()
+    expect(button(wrapper, 'Disconnect').attributes('disabled')).toBeUndefined()
+  })
+
+  it('replaces an old unofficial label with the refreshed server result', async () => {
+    api.fetchMcuDevices.mockResolvedValueOnce({ devices: [{ ...device }] })
+      .mockResolvedValueOnce({ devices: [{ ...device, is_official: true, official_verification: 'official' }] })
+    const wrapper = await render()
+    expect(wrapper.find('.n-tag').text()).toBe('Unofficial')
+
+    await button(wrapper, 'Refresh').trigger('click')
+    await flushPromises()
+
+    expect(api.fetchMcuDevices).toHaveBeenCalledTimes(2)
+    expect(wrapper.find('.n-tag').text()).toBe('Official')
+  })
+
+  it.each([false, true])('shows unavailable verification distinctly with cached official=%s', async isOfficial => {
+    api.fetchMcuDevices.mockResolvedValue({
+      devices: [{ ...device, is_official: isOfficial, official_verification: 'unavailable' }],
+    })
+    const wrapper = await render()
+    expect(wrapper.find('.n-tag').text()).toBe('Unverified')
+    expect(button(wrapper, 'Remote connect').attributes('disabled')).toBeUndefined()
+  })
+
+  it('localizes a temporary verification outage and permits retry without claiming success', async () => {
+    api.connectMcuDeviceRemote.mockRejectedValue(Object.assign(new Error('upstream unavailable'), {
+      status: 503, code: 'official_verification_unavailable',
+    }))
+    const wrapper = await render()
+
+    await button(wrapper, 'Remote connect').trigger('click')
+    await flushPromises()
+
+    expect(messages.error).toHaveBeenCalledWith(en.mcuDevices.officialVerificationUnavailable)
+    expect(messages.success).not.toHaveBeenCalled()
+    expect(wrapper.find('.n-tag').text()).toBe('Unverified')
+    expect(button(wrapper, 'Remote connect').attributes('disabled')).toBeUndefined()
+  })
+
+  it('preserves the server rejection for an actually unofficial device', async () => {
+    api.connectMcuDeviceRemote.mockRejectedValue(new Error('Official device required'))
+    const wrapper = await render()
+
+    await button(wrapper, 'Remote connect').trigger('click')
+    await flushPromises()
+
+    expect(messages.error).toHaveBeenCalledWith('Official device required')
+    expect(messages.success).not.toHaveBeenCalled()
+    expect(wrapper.find('.n-tag').text()).toBe('Unofficial')
+  })
+
+  it('clears a stale official channel after the server explicitly rejects its device code', async () => {
+    api.fetchMcuDevices.mockResolvedValue({
+      devices: [{ ...device, is_official: true, official_verification: 'official' }],
+    })
+    api.connectMcuDeviceRemote.mockRejectedValue(Object.assign(new Error('Official device required'), {
+      status: 403, code: 'unofficial_device_code',
+    }))
+    const wrapper = await render()
+    expect(wrapper.find('.n-tag').text()).toBe('Official')
+
+    await button(wrapper, 'Remote connect').trigger('click')
+    await flushPromises()
+
+    expect(messages.error).toHaveBeenCalledWith('Official device required')
+    expect(messages.success).not.toHaveBeenCalled()
+    expect(wrapper.find('.n-tag').text()).toBe('Unofficial')
+    expect(button(wrapper, 'Remote connect').attributes('disabled')).toBeUndefined()
+    expect(button(wrapper, 'Disconnect')).toBeUndefined()
+  })
+
+  it('defines verification labels and retry guidance in every supported locale', () => {
+    const locales = import.meta.glob<{ default: typeof en }>('../../packages/client/src/i18n/locales/*.ts', { eager: true })
+    expect(Object.keys(locales)).toHaveLength(supportedLocales.length)
+    for (const [path, locale] of Object.entries(locales)) {
+      expect(locale.default.mcuDevices.officialVerificationPending, path).toEqual(expect.any(String))
+      expect(locale.default.mcuDevices.officialVerificationUnavailable, path).toEqual(expect.any(String))
+      expect(locale.default.mcuDevices.officialVerificationPending, path).not.toBe('')
+      expect(locale.default.mcuDevices.officialVerificationUnavailable, path).not.toBe('')
+    }
+  })
+})
