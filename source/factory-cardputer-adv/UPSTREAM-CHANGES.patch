+esp_err_t Settings::Commit()
+{
+    if (!nvs_handle_ || !read_write_) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (!dirty_) {
+        return ESP_OK;
+    }
+    const auto result = nvs_commit(nvs_handle_);
+    if (result == ESP_OK) {
+        dirty_ = false;
+    }
+    return result;
+}
